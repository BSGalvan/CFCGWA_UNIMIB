   3.884355241109572*^9, 3.8843552420115213`*^9}, {3.884355741035067*^9, 
   3.884355805488061*^9}, {3.8844361424164248`*^9, 3.884436142554173*^9}, {
   3.987495411187292*^9, 3.98749546654257*^9}, {3.987495529998207*^9, 
   3.987495730989353*^9}, {3.987523598267291*^9, 3.987523601090012*^9}},
  ExpressionUUID->"6bec1d77-dd20-4deb-9eb7-783c778299ee"]
}], "Text",
 CellChangeTimes->{{3.987523629661537*^9, 
  3.987523669785892*^9}},ExpressionUUID->"bda865a5-e610-441f-b5a5-\
7f4f6773a579"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fmin", " ", "=", " ", "20"}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fISCO", "[", "m_", "]"}], ":=", 
    RowBox[{"4400", "/", "m"}]}], " ", ";"}], " ", 
  RowBox[{"(*", 
