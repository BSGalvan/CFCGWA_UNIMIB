9290a5bed306"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FIM", "[", 
   RowBox[{
   "h_", ",", "hconj_", ",", " ", "\[CapitalTheta]_", ",", 
    "\[CapitalTheta]vals_", ",", "fmax_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"\[CapitalTheta]Rule", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalTheta]", "[", 
         RowBox[{"[", "aa", "]"}], "]"}], "->", 
        RowBox[{"\[CapitalTheta]Vals", "[", 
         RowBox[{"[", "aa", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"aa", ",", "1", ",", 
         RowBox[{"Length", "[", "\[CapitalTheta]", "]"}]}], "}"}]}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"computes", " ", 
      RowBox[{"{", 
       RowBox[{
        FormBox[
         RowBox[{
          RowBox[{
           SubscriptBox["\[PartialD]", "i"], 
           RowBox[{
            SubscriptBox["h", "AP"], "(", 
            SubscriptBox["\[Theta]", "tr"], ")"}]}], ","}],
         TraditionalForm], " ", 
        FormBox[
         RowBox[{
          RowBox[{
           SubscriptBox["\[PartialD]", "j"], 
           RowBox[{
            SuperscriptBox[
             SubscriptBox["h", "AP"], "*"], "(", 
            SubscriptBox["\[Theta]", "tr"], ")"}]}], "}"}],
         TraditionalForm]}]}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"to", " ", "speed", " ", "things", " ", "up"}], ",", " ", 
      RowBox[{
      "first", " ", "sub", " ", "in", " ", "all", " ", "param", " ", "values",
        " ", "except", " ", "the", " ", "one", " ", "taking", " ", "the", " ",
        "derivative"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "also", " ", "only", " ", "computes", " ", "lower", " ", "corner"}], ",",
       " ", 
      RowBox[{"we", " ", "symmetrize", " ", "later"}]}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"\[CapitalGamma]pre1", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"aa", ">=", "bb"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"h", 
              RowBox[{"(*", 
               RowBox[{"/.", 
                RowBox[{"Drop", "[", 
                 RowBox[{"\[CapitalTheta]Rule", ",", 
                  RowBox[{"{", "aa", "}"}]}], "]"}]}], "*)"}], ",", 
              RowBox[{
              "\[CapitalTheta]", "\[LeftDoubleBracket]", "aa", 
               "\[RightDoubleBracket]"}]}], "]"}], ",", 
            RowBox[{"D", "[", 
             RowBox[{"hconj", 
              RowBox[{"(*", 
               RowBox[{"/.", 
                RowBox[{"Drop", "[", 
                 RowBox[{"\[CapitalTheta]Rule", ",", 
                  RowBox[{"{", "bb", "}"}]}], "]"}]}], "*)"}], ",", 
              RowBox[{
              "\[CapitalTheta]", "\[LeftDoubleBracket]", "bb", 
               "\[RightDoubleBracket]"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"aa", ",", "1", ",", 
          RowBox[{"Length", "[", "\[CapitalTheta]", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"bb", ",", "1", ",", 
          RowBox[{"Length", "[", "\[CapitalTheta]", "]"}]}], "}"}]}], "]"}], "/.",
       "\[CapitalTheta]Rule"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"computes", " ", "the", " ", "inner", " ", "products"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"\[CapitalGamma]pre2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Permutations", "[", 
          RowBox[{"{", 
           RowBox[{"aa", ",", "bb"}], "}"}], "]"}], "]"}], 
        RowBox[{"InnerProd", "[", 
         RowBox[{
          RowBox[{"\[CapitalGamma]pre1", "\[LeftDoubleBracket]", 
           RowBox[{"aa", ",", "bb", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
          RowBox[{"\[CapitalGamma]pre1", "\[LeftDoubleBracket]", 
           RowBox[{"aa", ",", "bb", ",", "2"}], "\[RightDoubleBracket]"}], ",",
           "fmax"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"aa", ",", "1", ",", 
         RowBox[{"Length", "[", "\[CapitalTheta]", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"bb", ",", "1", ",", 
         RowBox[{"Length", "[", "\[CapitalTheta]", "]"}]}], "}"}]}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"(*", "symmetrize", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Symmetrize", "[", "\[CapitalGamma]pre2", "]"}], "//", 
     "Normal"}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.883751217831859*^9, 3.883751253864563*^9}, 
   3.884437613947719*^9, 3.884437783907695*^9, {3.884437922698811*^9, 
   3.884437929989995*^9}, {3.922372734768374*^9, 3.922372752869052*^9}, {
   3.92237278304604*^9, 3.922372821317544*^9}, {3.922372891325779*^9, 
   3.922372978957531*^9}, {3.922873203488674*^9, 3.9228732369065933`*^9}, {
   3.987062624963389*^9, 3.98706262517968*^9}, {3.9870627467519703`*^9, 
   3.9870627468605413`*^9}, {3.987063672497497*^9, 3.987063674204102*^9}, {
   3.9870638946639233`*^9, 3.987063901163067*^9}, {3.9871486612823133`*^9, 
   3.987148664605782*^9}, {3.987149405132276*^9, 3.987149411271906*^9}, {
   3.987149452744214*^9, 3.987149473963374*^9}, {3.9874811406764183`*^9, 
   3.98748115928015*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"15b526b0-0cfa-4bca-a3bf-d1654305d2c7"]
