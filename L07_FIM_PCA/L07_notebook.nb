   3.987528012999016*^9},ExpressionUUID->"fc400eb4-34b8-43df-989a-\
25535bf22291"],

Cell[BoxData[
 RowBox[{"fimNew", "=", " ", 
  RowBox[{"FIM", "[", 
   RowBox[{
   "hNew", " ", ",", "hconjNew", ",", "\[CapitalPhi]", ",", 
    "\[CapitalPhi]Vals", ",", "fmax"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.987517983710623*^9, 3.9875179861632843`*^9}, 
   3.9875186982815533`*^9},
 CellLabel->
  "In[165]:=",ExpressionUUID->"4711452b-3614-4c9d-a2e5-d0f08dffb983"],

Cell["\<\
What happens when you add PN corrections to the waveform?
Why is the FIM not always diagonal even when the waveform is expressed in \
terms of the principal components?
What happens when you compute the PCA in a different region of parameter \
space?\
\>", "Text",
 CellChangeTimes->{{3.9872171772678413`*^9, 3.987217184883375*^9}, {
   3.9874882242669888`*^9, 3.987488257144709*^9}, {3.987488293426818*^9, 
   3.987488837151437*^9}, {3.98748924328406*^9, 3.987489244524992*^9}, {
   3.987489278032262*^9, 3.987489310245287*^9}, 3.9874893742177143`*^9, {
   3.987489410140876*^9, 3.987489446848838*^9}, {3.987490137897176*^9, 
   3.987490225368162*^9}, {3.987490328782167*^9, 3.987490336921631*^9}, {
   3.987490398651081*^9, 3.9874905639356537`*^9}, {3.987516525363152*^9, 
   3.987516583572666*^9}, {3.987518355177829*^9, 3.987518435729051*^9}, {
   3.987518480396248*^9, 3.987518491088327*^9}, {3.987519962276964*^9, 
   3.987520049095488*^9}, {3.987520200425687*^9, 3.987520257137995*^9}, {
   3.9875203521794357`*^9, 3.987520515807913*^9}, {3.987528020414117*^9, 
   3.9875280428274317`*^9}},ExpressionUUID->"b41fa0f2-d6d7-4bd8-a3f9-\
bff9cc2ae801"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A short coming of PCAs", "Subsection",
 CellChangeTimes->{{3.9874902629268847`*^9, 3.987490319607202*^9}, {
  3.987518775071493*^9, 3.987518808152787*^9}, {3.987519393998102*^9, 
  3.987519406465102*^9}},ExpressionUUID->"6691bcd7-edfd-4810-9c42-\
5d9343d6d143"],

Cell[TextData[{
 "What happens if we start with the waveform in terms of different mass \
parameters, such as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "79e7f25d-da2b-4f2d-a21b-996ca70a79d9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "90373602-16a1-435d-b31a-825725d01167"],
 "?"
}], "Text",
 CellChangeTimes->{{3.987528145458169*^9, 
  3.987528170095694*^9}},ExpressionUUID->"c8c4b870-a82a-4f1e-9f14-\
d34e0382097d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalTheta]2", "=", " ", 
   RowBox[{"{", 
    RowBox[{"logm1", ",", "logm2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalTheta]Vals2", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Log", "[", "m1", "]"}], ",", 
      RowBox[{"Log", "[", "m2", "]"}]}], "}"}], "/.", "params"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9870624011724663`*^9, 3.9870624069215937`*^9}, {
   3.987062469561234*^9, 3.9870625477379513`*^9}, {3.987134580285644*^9, 
   3.987134584576962*^9}, {3.987135285293461*^9, 3.9871352900852013`*^9}, {
   3.987136883407486*^9, 3.987136894486657*^9}, {3.987145987544346*^9, 
   3.987146009669243*^9}, {3.987149418852541*^9, 3.987149419181326*^9}, {
   3.98747888925561*^9, 3.987478891320361*^9}, 3.987481358562819*^9, {
   3.98749042094007*^9, 3.987490421571019*^9}, 3.987490457988471*^9, {
   3.9875156994851294`*^9, 3.987515712174963*^9}, {3.98751598746277*^9, 
   3.987515992786071*^9}, {3.987516157581396*^9, 3.987516164395701*^9}, {
   3.987519278179758*^9, 3.987519300428636*^9}, {3.9875196078796377`*^9, 
   3.987519608758922*^9}},
 CellLabel->
  "In[214]:=",ExpressionUUID->"189af724-a027-44fa-8cc7-169f6a1ace07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"logRule2", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m1", " ", "->", 
      RowBox[{"Exp", "[", "logm1", "]"}]}], ",", 
     RowBox[{"m2", "->", 
      RowBox[{"Exp", "[", "logm2", "]"}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.987515994081684*^9, 3.987516031058755*^9}, {
   3.9875193014175386`*^9, 3.9875193107655582`*^9}, 3.987519353053604*^9, 
   3.987519610421721*^9},
 CellLabel->
  "In[216]:=",ExpressionUUID->"d91389a0-1bd9-40d3-b512-efd5134b341f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"h2", " ", "=", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"FDStrain", "[", "0", "]"}], "/.", "m1m2Rule"}], ",", 
       "assumptions"}], "]"}], "/.", "logRule2"}], "/.", 
    "nonSampledParamsRule"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hconj2", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"FDStrainConj", "[", "0", "]"}], "/.", "m1m2Rule"}], ",", 
       "assumptions"}], "]"}], "/.", "logRule2"}], "/.", 
    "nonSampledParamsRule"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987519035069837*^9, 3.987519080811901*^9}, {
  3.98751961360889*^9, 3.987519617853793*^9}},
 CellLabel->
  "In[217]:=",ExpressionUUID->"e98d199f-8be1-4f60-8264-ccc2c140232d"],

Cell[BoxData[
 RowBox[{"fim2", " ", "=", " ", 
  RowBox[{"FIM", "[", 
   RowBox[{
   "h2", " ", ",", "hconj2", ",", " ", "\[CapitalTheta]2", ",", 
    "\[CapitalTheta]Vals2", ",", "fmax"}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.987519620113429*^9, {3.987557764685748*^9, 3.9875577692641487`*^9}},
 CellLabel->
  "In[219]:=",ExpressionUUID->"6d087e01-dace-4372-ac53-d42fa8687fbd"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"Eigenvectors", "[", "fim2", "]"}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"EigenVecs2", " ", "=", 
     RowBox[{
      RowBox[{"%", "/", 
       RowBox[{"(", 
        RowBox[{"%", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], ")"}]}], "//", 
      "Rationalize"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"\[CapitalPhi]expr2", " ", "=", " ", 
    RowBox[{"EigenVecs2", ".", "\[CapitalTheta]2"}]}]}]}]], "Input",
 CellChangeTimes->{{3.987519648689563*^9, 3.9875196506589823`*^9}, {
   3.987519777606326*^9, 3.987519782061269*^9}, {3.98755775569164*^9, 
   3.987557756551745*^9}, 3.987557808338081*^9},
 CellLabel->
  "In[220]:=",ExpressionUUID->"2ceec3a7-c7d0-48df-8e5f-4de9cc1877fc"],

Cell[TextData[{
 "A PCA only returns linear combinations of the original parameters. There is \
no way to express log[\[ScriptCapitalM]] as a linear combination of ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{"log", "[", " ", 
    SubscriptBox["m", "1"], "]"}]}]],
  CellChangeTimes->{{3.9872171772678413`*^9, 3.987217184883375*^9}, {
    3.9874882242669888`*^9, 3.987488257144709*^9}, {3.987488293426818*^9, 
    3.987488837151437*^9}, {3.98748924328406*^9, 3.987489244524992*^9}, {
    3.987489278032262*^9, 3.987489310245287*^9}, 3.9874893742177143`*^9, {
    3.987489410140876*^9, 3.987489446848838*^9}, {3.987490137897176*^9, 
    3.987490225368162*^9}, {3.987490328782167*^9, 3.987490336921631*^9}, {
    3.987490398651081*^9, 3.9874905639356537`*^9}, {3.987516525363152*^9, 
    3.987516583572666*^9}, {3.987518355177829*^9, 3.987518395145294*^9}, {
    3.9875194136930723`*^9, 3.9875195339762707`*^9}, {3.9875196606692133`*^9, 
    3.9875196647932053`*^9}, {3.987519744014456*^9, 3.987519746006466*^9}, {
    3.987519786275197*^9, 3.9875199430542316`*^9}},ExpressionUUID->
  "5ca2a73b-f3be-44ef-9554-0a95f89170b0"],
 " and ",
 Cell[BoxData[
  RowBox[{"log", "[", 
   SubscriptBox["m", "2"], "]"}]],
  CellChangeTimes->{{3.9872171772678413`*^9, 3.987217184883375*^9}, {
    3.9874882242669888`*^9, 3.987488257144709*^9}, {3.987488293426818*^9, 
    3.987488837151437*^9}, {3.98748924328406*^9, 3.987489244524992*^9}, {
    3.987489278032262*^9, 3.987489310245287*^9}, 3.9874893742177143`*^9, {
    3.987489410140876*^9, 3.987489446848838*^9}, {3.987490137897176*^9, 
    3.987490225368162*^9}, {3.987490328782167*^9, 3.987490336921631*^9}, {
    3.987490398651081*^9, 3.9874905639356537`*^9}, {3.987516525363152*^9, 
    3.987516583572666*^9}, {3.987518355177829*^9, 3.987518395145294*^9}, {
    3.9875194136930723`*^9, 3.9875195339762707`*^9}, {3.9875196606692133`*^9, 
    3.9875196647932053`*^9}, {3.987519744014456*^9, 3.987519746006466*^9}, {
    3.987519786275197*^9, 3.9875199430542316`*^9}},ExpressionUUID->
  "b51d5a70-7165-4270-849f-6da7f8246940"],
 " so the PCa cannot return log[\[ScriptCapitalM]] even though \
\[ScriptCapitalM] is clearly the best parameter to sample in "
}], "Text",
 CellChangeTimes->{{3.98752817763395*^9, 
  3.987528260445651*^9}},ExpressionUUID->"2b936c42-b897-4c23-b5de-\
986766adadc3"],

