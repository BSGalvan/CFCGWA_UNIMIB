Cell[CellGroupData[{

Cell["PCA of the (post-)Newtonian Waveform ", "Subsection",
 CellChangeTimes->{{3.9874902629268847`*^9, 3.987490319607202*^9}, {
  3.987518775071493*^9, 3.987518808152787*^9}, {3.987519752790133*^9, 
  3.987519758664219*^9}},ExpressionUUID->"67946b99-7268-4435-8b9b-\
fa9146f16753"],

Cell["\<\
When computing the waveform, it is natural to parameterize the masses in \
terms of total mass m and symmetric mass ration \[Eta]. However this is not \
the best parameterization for parameter estimation. \
\>", "Text",
 CellChangeTimes->{{3.9872171772678413`*^9, 3.987217184883375*^9}, {
   3.9874882242669888`*^9, 3.987488257144709*^9}, {3.987488293426818*^9, 
