Cell[CellGroupData[{

Cell["Taylor F2 waveform ", "Subsection",
 CellChangeTimes->{{3.9875131978343573`*^9, 
  3.9875132073026047`*^9}},ExpressionUUID->"a0c2dd51-8a28-4732-a1cc-\
04921e06d03a"],

Cell["\<\
This is the TaylorF2 waveform, which is the standard PN inspiral waveform \
(see arXiv:0907.0700)
This is the waveform we computed at Newtonian order in L03. \
\>", "Text",
 CellChangeTimes->{{3.884353995595696*^9, 3.884354067893775*^9}, {
   3.8843541499244947`*^9, 3.8843544300078297`*^9}, {3.884354506534966*^9, 
