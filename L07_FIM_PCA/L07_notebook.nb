  3.987523609612605*^9}},ExpressionUUID->"0b6d21f0-6d6f-419a-9ad1-\
1fb2b4172f8a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    SubscriptBox["h", "1"], "|", 
    SubscriptBox["h", "2"]}], ")"}], " ", "=", " ", 
  RowBox[{"4", " ", "Re", " ", 
   RowBox[{"\[Integral]", 
    RowBox[{
     FractionBox[
      RowBox[{" ", 
       RowBox[{
        SubscriptBox[
         OverscriptBox["h", "~"], "1"], 
        SuperscriptBox[
         SubscriptBox[
          OverscriptBox["h", "~"], "2"], "*"]}]}], 
      SubscriptBox["S", "n"]], "df", " "}]}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.884354674835232*^9, 3.884354769469817*^9}, {
   3.8843549150426826`*^9, 3.884354918476428*^9}, {3.884355035077383*^9, 
   3.884355048758194*^9}, {3.88435508735155*^9, 3.884355092160668*^9}, {
