 CellLabel->"In[8]:=",ExpressionUUID->"45d8028c-8a8d-4019-9d16-eec0d3401cd6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"define", " ", "the", " ", "PDF"}], "*)"}], "\[IndentingNewLine]", 
  " ", 
  RowBox[{
   RowBox[{"pdf", " ", "=", " ", 
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"0", ",", "\[Sigma]"}], "]"}], ",", "x"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"take", " ", "the", " ", "log", " ", "and", " ", "simplify"}], 
    " ", "*)"}], "\[IndentingNewLine]", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Log", "[", "%", "]"}], ",", 
     RowBox[{
      RowBox[{"x", "\[Element]", "Reals"}], " ", "&&", 
      RowBox[{"\[Sigma]", ">", "0"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"define", " ", "the", " ", "summand"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"tosum", " ", "=", " ", 
    RowBox[{"-", " ", 
     RowBox[{"D", "[", 
      RowBox[{"%", ",", "\[Sigma]", ",", "\[Sigma]"}], "]"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "take", " ", "the", " ", "sum", " ", "and", " ", "evaluate", " ", "at", " ",
      "the", " ", "injection", " ", "value"}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{"tosum", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "data"}], "}"}]}], "]"}], "/.", 
    RowBox[{"\[Sigma]", "->", "3"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"compute", " ", 
     SubscriptBox["\[Sigma]", "\[Sigma]"]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", "%", "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.98715075438028*^9, 3.987150755025571*^9}, {
   3.987214312256604*^9, 3.987214324263399*^9}, {3.98721463444741*^9, 
