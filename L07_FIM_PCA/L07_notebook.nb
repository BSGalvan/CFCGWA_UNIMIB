Cell[CellGroupData[{

Cell["mass and spin parameter conversions  ", "Subsection",
 CellChangeTimes->{{3.9874818038944187`*^9, 3.987481804736731*^9}, {
  3.987494462898364*^9, 
  3.987494470845186*^9}},ExpressionUUID->"24afda28-ff4d-4df1-94b8-\
c00372f724a1"],

Cell["\<\
The waveform is written in terms of various mass and spin parameters for \
convenience reasons, but it is useful to have rules to convert expressions \
into the pairs of parameters we are interested in \
\>", "Text",
 CellChangeTimes->{{3.884353995595696*^9, 3.884354067893775*^9}, {
  3.8843541499244947`*^9, 3.8843544300078297`*^9}, {3.884354506534966*^9, 
  3.8843545201271276`*^9}, {3.987494628836685*^9, 3.987494696757413*^9}, {
  3.987523046943672*^9, 
  3.987523052248967*^9}},ExpressionUUID->"372f4222-91e7-40ad-aed5-\
9d1b9672d29c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"m1m2Rule", " ", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m1", "\[Rule]", "m1"}], ",", 
     RowBox[{"m2", "\[Rule]", "m2"}], ",", 
     RowBox[{"m", "\[Rule]", 
      RowBox[{"m1", "+", "m2"}]}], ",", 
     RowBox[{"\[Eta]", "\[Rule]", 
      FractionBox[
       RowBox[{"m1", " ", "m2"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"m1", "+", "m2"}], ")"}], "2"]]}], ",", 
     RowBox[{"\[ScriptCapitalM]", "\[Rule]", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"m1", " ", "m2"}], ")"}], 
        RowBox[{"3", "/", "5"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"m1", "+", "m2"}], ")"}], 
        RowBox[{"1", "/", "5"}]]]}], ",", 
     RowBox[{"q", "\[Rule]", 
      FractionBox["m2", "m1"]}], ",", 
     RowBox[{"\[Delta]", "\[Rule]", 
      FractionBox[
       RowBox[{"m1", "-", "m2"}], 
       RowBox[{"m1", "+", "m2"}]]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m\[Eta]Rule", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m1", "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], " ", "m", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SqrtBox[
          RowBox[{"1", "-", 
           RowBox[{"4", " ", "\[Eta]"}]}]]}], ")"}]}]}], ",", 
     RowBox[{"m2", "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], " ", "m", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SqrtBox[
          RowBox[{"1", "-", 
           RowBox[{"4", " ", "\[Eta]"}]}]]}], ")"}]}]}], ",", 
     RowBox[{"m", "\[Rule]", "m"}], ",", 
     RowBox[{"\[Eta]", "\[Rule]", "\[Eta]"}], ",", 
     RowBox[{"\[ScriptCapitalM]", "\[Rule]", 
      RowBox[{"m", " ", 
       SuperscriptBox["\[Eta]", 
        RowBox[{"3", "/", "5"}]]}]}], ",", 
     RowBox[{"q", "\[Rule]", 
      FractionBox[
       RowBox[{"1", "-", 
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"4", " ", "\[Eta]"}]}]]}], 
       RowBox[{"1", "+", 
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"4", " ", "\[Eta]"}]}]]}]]}], ",", 
     RowBox[{"\[Delta]", "\[Rule]", 
      SqrtBox[
       RowBox[{"1", "-", 
        RowBox[{"4", " ", "\[Eta]"}]}]]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalM]qRule", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m1", "\[Rule]", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"1", "+", "q"}], 
          SuperscriptBox["q", "3"]], ")"}], 
        RowBox[{"1", "/", "5"}]], " ", "\[ScriptCapitalM]"}]}], ",", 
     RowBox[{"m2", "\[Rule]", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["q", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", "q"}], ")"}]}], ")"}], 
        RowBox[{"1", "/", "5"}]], " ", "\[ScriptCapitalM]"}]}], ",", 
     RowBox[{"m", "\[Rule]", 
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "q"}], ")"}], 
         RowBox[{"6", "/", "5"}]], " ", "\[ScriptCapitalM]"}], 
       SuperscriptBox["q", 
        RowBox[{"3", "/", "5"}]]]}], ",", 
     RowBox[{"\[Eta]", "\[Rule]", 
      FractionBox["q", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "q"}], ")"}], "2"]]}], ",", 
     RowBox[{"\[ScriptCapitalM]", "\[Rule]", "\[ScriptCapitalM]"}], ",", 
     RowBox[{"q", "\[Rule]", "q"}], ",", 
     RowBox[{"\[Delta]", "\[Rule]", 
      FractionBox[
       RowBox[{"1", "-", "q"}], 
       RowBox[{"1", "+", "q"}]]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Chi]1\[Chi]2Rule", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Chi]1", "\[Rule]", "\[Chi]1"}], ",", 
     RowBox[{"\[Chi]2", "\[Rule]", "\[Chi]2"}], ",", 
     RowBox[{"\[Chi]2", "\[Rule]", "\[Chi]2"}], ",", 
     RowBox[{"\[Chi]s", "\[Rule]", 
      FractionBox[
       RowBox[{"\[Chi]1", "+", "\[Chi]2"}], "2"]}], ",", 
     RowBox[{"\[Chi]a", "\[Rule]", 
      FractionBox[
       RowBox[{"\[Chi]1", "-", "\[Chi]2"}], "2"]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Chi]s\[Chi]aRule", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Chi]1", "\[Rule]", 
      RowBox[{"\[Chi]a", "+", "\[Chi]s"}]}], ",", 
     RowBox[{"\[Chi]2", "\[Rule]", 
      RowBox[{
       RowBox[{"-", "\[Chi]a"}], "+", "\[Chi]s"}]}], ",", 
     RowBox[{"\[Chi]s", "\[Rule]", "\[Chi]s"}], ",", 
     RowBox[{"\[Chi]a", "\[Rule]", "\[Chi]a"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987494327707345*^9, 3.987494459328719*^9}, {
  3.987494521348029*^9, 3.9874945228176622`*^9}, {3.987494578138133*^9, 
  3.9874946212714787`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"301f7dda-ade6-4cfc-82b0-12e589e89b28"]
}, Open  ]],

