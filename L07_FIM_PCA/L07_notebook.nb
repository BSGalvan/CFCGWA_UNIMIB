180d71ae5cc0"],

Cell[BoxData[{
 RowBox[{"hNew", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"h", "/.", "\[Theta]to\[CurlyPhi]Rule"}], ",", " ", 
    RowBox[{
     RowBox[{"log\[CurlyPhi]1", ">", "1"}], "&&", " ", 
     RowBox[{"log\[CurlyPhi]2", ">", "2"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"hconjNew", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"hconj", "/.", "\[Theta]to\[CurlyPhi]Rule"}], ",", " ", 
    RowBox[{
     RowBox[{"log\[CurlyPhi]1", ">", "1"}], "&&", " ", 
     RowBox[{"log\[CurlyPhi]2", ">", "2"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.987517191815874*^9, 3.9875172469609957`*^9}, {
   3.9875174560647697`*^9, 3.987517471486031*^9}, {3.987517531524148*^9, 
