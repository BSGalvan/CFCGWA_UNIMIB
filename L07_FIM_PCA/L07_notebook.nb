    3.9872150226648207`*^9, 3.987215070037407*^9}, {3.987215245450569*^9, 
    3.987215359936054*^9}, 3.987215451268074*^9, {3.987215761819269*^9, 
    3.9872158695164557`*^9}, {3.987215921963995*^9, 3.987216046756652*^9}, {
    3.9872161308085203`*^9, 3.987216138586874*^9}, {3.987217430023179*^9, 
