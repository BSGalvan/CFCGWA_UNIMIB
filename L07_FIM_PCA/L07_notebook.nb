Cell["\<\
Define the sampled parameters and their injection values.
A PCA returns linear combinations of the original parameters.
We would like our final result to be the product of the original parameters \
so we will work in terms of logs.\
\>", "Text",
 CellChangeTimes->{{3.9872171772678413`*^9, 3.987217184883375*^9}, {
   3.9874882242669888`*^9, 3.987488257144709*^9}, {3.987488293426818*^9, 
   3.987488837151437*^9}, {3.98748924328406*^9, 3.987489244524992*^9}, {
   3.987489278032262*^9, 3.987489310245287*^9}, 3.9874893742177143`*^9, {
   3.987489410140876*^9, 3.987489446848838*^9}, {3.987490137897176*^9, 
   3.987490225368162*^9}, {3.987490328782167*^9, 3.987490336921631*^9}, {
   3.987490398651081*^9, 3.987490456461378*^9}, {3.9875278715876083`*^9, 
   3.987527895377474*^9}, {3.987532961463485*^9, 
   3.987533064802617*^9}},ExpressionUUID->"4fca22aa-7c56-4511-b3e9-\
9543b9efc61e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalTheta]", "=", " ", 
   RowBox[{"{", 
    RowBox[{"logm", ",", "log\[Eta]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalTheta]Vals", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Log", "[", "m", "]"}], ",", 
      RowBox[{"Log", "[", "\[Eta]", "]"}]}], "}"}], "/.", "params"}]}], 
