3d093df3dbbb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["\[Theta]", "i"]}]], 
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["\[Theta]", "j"]}]], "log"}]}]}], " ", 
   RowBox[{"\[ScriptCapitalL]", "[", 
