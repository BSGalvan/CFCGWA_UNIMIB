Cell[TextData[{
 "Generally, we say a FIM has done a good job approximating the posterior \
when the standard deviations are within an order of magnitude of the true \
values, so we have done a pretty good job here. What factors may be \
contributing to the differences between the true posterior and the \
approximation?\n\nWhat happens if you set ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["m", "1"], " ", "=", " ", 
   RowBox[{"10", 
    SubscriptBox["M", 
     RowBox[{"\[CircleDot]", " "}]]}]}]],
  CellChangeTimes->{{3.9872171772678413`*^9, 3.987217184883375*^9}, {
    3.9874882242669888`*^9, 3.987488257144709*^9}, {3.987488293426818*^9, 
    3.987488837151437*^9}, {3.98748924328406*^9, 3.987489244524992*^9}, {
    3.987489278032262*^9, 3.987489310245287*^9}, 3.9874893742177143`*^9, {
    3.987489410140876*^9, 3.987489446848838*^9}, {3.987490137897176*^9, 
    3.987490169546139*^9}, {3.987490228546022*^9, 3.98749022916411*^9}, {
    3.98749033855897*^9, 3.98749036487938*^9}, 3.987529540219737*^9},
  ExpressionUUID->"f2ecd75f-83bc-4f85-944a-78c1b376dd43"],
 "and ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{
    SubscriptBox["m", "2"], " ", "=", " ", 
    RowBox[{"10", " ", 
     SubscriptBox["M", 
      RowBox[{"\[CircleDot]", " "}]]}]}]}]],
  CellChangeTimes->{{3.9872171772678413`*^9, 3.987217184883375*^9}, {
    3.9874882242669888`*^9, 3.987488257144709*^9}, {3.987488293426818*^9, 
    3.987488837151437*^9}, {3.98748924328406*^9, 3.987489244524992*^9}, {
