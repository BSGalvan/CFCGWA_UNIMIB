53568aee0772"],

Cell[TextData[{
 "We are disregarding the dependance on  extrinsic parameters which enter \
into the amplitude of the waveform . The factor below was chosen to obtain \
the correct SNR based for extrinsic parameters ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "jn"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "827b80f1-2b12-47af-b4c2-d96f042430ba"],
 " = 0.4, ra = 1.375, dec = -1.2108 ,  \[Psi] = 2.659."
}], "Text",
 CellChangeTimes->{{3.884354674835232*^9, 3.884354769469817*^9}, {
   3.8843549150426826`*^9, 3.884354918476428*^9}, {3.884355035077383*^9, 
