   3.987490398651081*^9, 3.987490411318618*^9}, {3.987490451437395*^9, 
   3.9874904522024717`*^9}, {3.98755746808783*^9, 
   3.987557632766992*^9}},ExpressionUUID->"1ae1f649-4eb5-4665-9888-\
07ea7fdf5898"],

