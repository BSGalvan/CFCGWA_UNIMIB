   RowBox[{"\[Phi]", "[", "order_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["\[Pi]", "4"]}], "+", " ", 
    RowBox[{"2", " ", "\[Pi]", " ", "f", " ", "tc"}], "-", 
    RowBox[{"2", " ", "\[Phi]c"}], " ", "+", 
    RowBox[{"\[ScriptCapitalP]0", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[ScriptCapitalP]", "[", "n", "]"}], 
        SuperscriptBox["v", "n"]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "order"}], "}"}]}], "]"}]}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.987147960056562*^9, 3.987147987305029*^9}, {
   3.987148032818019*^9, 3.987148038275703*^9}, 3.98714823856444*^9, 
