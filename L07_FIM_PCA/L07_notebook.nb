Cell[CellGroupData[{

Cell["principal component analysis ", "Section",
 CellChangeTimes->{{3.862999289952991*^9, 3.862999291654682*^9}, {
  3.864555940054102*^9, 3.864555940796788*^9}, {3.883493851685136*^9, 
