Cell[BoxData[
 RowBox[{
  RowBox[{"InjectionParams", "[", "\[IndentingNewLine]", 
   RowBox[{"m1Input_", 
    RowBox[{"(*", "Msol", "*)"}], ",", "m2Input_", 
    RowBox[{"(*", "Msol", "*)"}], ",", "\[IndentingNewLine]", "\[Chi]1Input_",
     ",", "\[Chi]2Input_", ",", " ", "\[IndentingNewLine]", "dLInput_", 
    RowBox[{"(*", "Mpc", "*)"}], ",", "tcInput_", 
    RowBox[{"(*", "s", "*)"}], ",", "\[Phi]cInput_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"m1", "->", "m1Input"}], ",", "\[IndentingNewLine]", 
    RowBox[{"m2", " ", "->", "m2Input"}], " ", ",", "\[IndentingNewLine]", 
    RowBox[{"m", " ", "->", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"m", "  ", "/.", "m1m2Rule"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"m1", "->", "m1Input"}], ",", 
         RowBox[{"m2", "->", "m2Input"}]}], "}"}]}], ")"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\[ScriptCapitalM]", "->", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ScriptCapitalM]", "  ", "/.", "m1m2Rule"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"m1", "->", "m1Input"}], ",", 
         RowBox[{"m2", "->", "m2Input"}]}], "}"}]}], ")"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Eta]", " ", "->", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Eta]", " ", "/.", "m1m2Rule"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"m1", "->", "m1Input"}], ",", 
         RowBox[{"m2", "->", "m2Input"}]}], "}"}]}], ")"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"q", " ", "->", 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"q", " ", "/.", "m1m2Rule"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"m1", "->", "m1Input"}], ",", 
         RowBox[{"m2", "->", "m2Input"}]}], "}"}]}], ")"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Delta]", "->", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Delta]", "/.", "m1m2Rule"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"m1", "->", "m1Input"}], ",", 
         RowBox[{"m2", "->", "m2Input"}]}], "}"}]}], ")"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Chi]1", "->", "\[Chi]1Input"}], ",", "\[IndentingNewLine]", 
