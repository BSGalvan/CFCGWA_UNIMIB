Cell["\<\
Here, we construct the frequency domain strain and its conjugate 
We can choose the PN order of the phase by entering the highest power of v \
(i.e. 7 for 3.5PN) \
\>", "Text",
 CellChangeTimes->{{3.884354674835232*^9, 3.884354769469817*^9}, {
  3.8843549150426826`*^9, 3.884354918476428*^9}, {3.884355035077383*^9, 
  3.884355048758194*^9}, {3.88435508735155*^9, 3.884355092160668*^9}, {
  3.884355241109572*^9, 3.8843552420115213`*^9}, {3.884355741035067*^9, 
  3.884355805488061*^9}, {3.8844361424164248`*^9, 3.884436142554173*^9}, {
  3.9874899638238087`*^9, 3.9874900623078957`*^9}, {3.987495271136633*^9, 
  3.987495382686989*^9}, {3.987513308579653*^9, 3.987513319116262*^9}, {
  3.987513350796167*^9, 3.9875134029133*^9}, {3.987513569171574*^9, 
  3.9875135911886272`*^9}, {3.987523473227125*^9, 
  3.987523527569273*^9}},ExpressionUUID->"5c699863-305c-4c39-b104-\
af446be300fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"FDStrain", "[", "order_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"ExtrinsicParamFactor", " ", "\[ScriptCapitalA]0", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"\[Phi]", "[", "order", "]"}]}]]}], "/.", 
     "\[ScriptCapitalM]qRule"}], "/.", "\[Chi]1\[Chi]2Rule"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FDStrainConj", "[", "order_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"ExtrinsicParamFactor", " ", "\[ScriptCapitalA]0", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"\[Phi]", "[", "order", "]"}]}]]}], "/.", 
     "\[ScriptCapitalM]qRule"}], "/.", "\[Chi]1\[Chi]2Rule"}]}], 
  ";"}]}], "Input",
